#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════╗
# ║  🔒 Melodio API Key Leak Prevention Hook                     ║
# ║  4/18 Gemini 키 노출 사고 (277만원) + Claude 키 사고 재발 방지   ║
# ║  커밋 시 API 키 패턴이 감지되면 커밋을 원천 차단합니다             ║
# ╚═══════════════════════════════════════════════════════════════╝

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${GREEN}🔒 Melodio API Key Leak Scanner 실행 중...${NC}"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then exit 0; fi

PATTERNS=(
  "Anthropic Claude API Key|sk-ant-api[0-9]+-[A-Za-z0-9_-]{20,}"
  "Google/Gemini API Key|AIzaSy[0-9A-Za-z_-]{20,}"
  "GitHub PAT (classic)|ghp_[0-9A-Za-z]{36}"
  "GitHub PAT (fine-grained)|github_pat_[0-9A-Za-z_]{82}"
  "AWS Access Key|AKIA[0-9A-Z]{16}"
  "Stripe Secret Key|sk_live_[0-9a-zA-Z]{24,}"
  "Stripe Publishable Key|pk_live_[0-9a-zA-Z]{24,}"
  "Supabase Service Role JWT|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]*InNlcnZpY2Vfcm9sZS[A-Za-z0-9_-]*\.[A-Za-z0-9_-]{40,}"
  "Discord Webhook URL|discord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+"
  "Generic Private Key|-----BEGIN (RSA |EC )?PRIVATE KEY-----"
  "Generic Secret/Password|['\"]?(password|secret|api_key|apikey|access_token|auth_token)['\"]?\s*[:=]\s*['\"][A-Za-z0-9+/=_-]{16,}['\"]"
)

EXEMPT_FILES=(
  ".env.example"
  "*.md"
  "*.lock"
  "package.json"
  ".gitignore"
  ".githooks/*"
  "*.sql"
)

FOUND=0
REPORT=""

for FILE in $STAGED_FILES; do
  SKIP=0
  for EXEMPT in "${EXEMPT_FILES[@]}"; do
    if [[ "$FILE" == $EXEMPT ]]; then SKIP=1; break; fi
  done
  [ $SKIP -eq 1 ] && continue
  if file "$FILE" 2>/dev/null | grep -q "binary"; then continue; fi
  STAGED_CONTENT=$(git show ":$FILE" 2>/dev/null)
  if [ -z "$STAGED_CONTENT" ]; then continue; fi

  for PATTERN_ENTRY in "${PATTERNS[@]}"; do
    DESCRIPTION="${PATTERN_ENTRY%%|*}"
    REGEX="${PATTERN_ENTRY##*|}"
    MATCHES=$(echo "$STAGED_CONTENT" | grep -nE "$REGEX" 2>/dev/null | head -3)
    if [ -n "$MATCHES" ]; then
      FOUND=1
      REPORT+="\n${RED}🚨 $DESCRIPTION 감지!${NC}\n"
      REPORT+="   📄 파일: ${YELLOW}$FILE${NC}\n"
      while IFS= read -r LINE; do
        LINENUM=$(echo "$LINE" | cut -d: -f1)
        MASKED=$(echo "$LINE" | sed -E 's/([A-Za-z0-9_-]{4})[A-Za-z0-9_+\/=-]{10,}/\1***MASKED***/g')
        REPORT+="   ├─ Line $LINENUM: $MASKED\n"
      done <<< "$MATCHES"
    fi
  done
done

if [ $FOUND -eq 1 ]; then
  echo ""
  echo -e "${RED}╔═══════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║  🚫 커밋 차단! API 키/시크릿이 감지되었습니다        ║${NC}"
  echo -e "${RED}║                                                       ║${NC}"
  echo -e "${RED}║  ⚠️  4/18 사고 교훈: 키 노출 → 계정정지 + 277만원    ║${NC}"
  echo -e "${RED}╚═══════════════════════════════════════════════════════╝${NC}"
  echo -e "$REPORT"
  echo -e "${YELLOW}💡 해결 방법:${NC}"
  echo -e "   1. API 키를 .env.local 파일로 이동하세요"
  echo -e "   2. 코드에서 process.env.KEY_NAME으로 참조하세요"
  echo -e "   3. 정말 안전한 경우: git commit --no-verify"
  echo ""

  # 🔔 텔레그램 긴급 알림 (MacMiniOps/Melodio 봇)
  TG_TOKEN="8703056964:AAH1YTVA9RTPQxkXfHvTCrOzfWpL62EitSM"
  TG_CHAT="814032806"
  ALERT_FILES=$(echo "$STAGED_FILES" | head -5 | tr '\n' ', ')
  TG_MSG="🚨 *Melodio 보안 경고*

⛔ API 키가 포함된 커밋이 *차단*되었습니다!

📍 프로젝트: \`Melodio Web\`
🕐 시각: $(date '+%Y-%m-%d %H:%M:%S')
📄 파일: \`${ALERT_FILES}\`

⚠️ 보안 훅이 작동했습니다. 키를 .env.local로 이동 후 재커밋하세요."

  curl -s -X POST \
    "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
    -d "chat_id=${TG_CHAT}" \
    -d "text=${TG_MSG}" \
    -d "parse_mode=Markdown" \
    > /dev/null 2>&1 &

  echo -e "${YELLOW}📱 Melodio 텔레그램 보안 알림 전송 완료${NC}"
  exit 1
fi

echo -e "${GREEN}✅ Melodio API Key Leak Scanner 통과! 안전합니다.${NC}"
exit 0
